    "@testing-library/user-event": "14.6.1",
    "@types/dagre": "0.7.52",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "postcss": "8.5.26",
    "prettier": "3.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
