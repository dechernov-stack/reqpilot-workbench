              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_VERIFICATION_METHOD</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0418\u043d\u0436\u0435\u043d\u0435\u0440 \u043f\u043e \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f\u043c">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_OWNER</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0422\u0417 \u043f\u0438\u043b\u043e\u0442\u0430, \u0440\u0430\u0437\u0434\u0435\u043b 8">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0442\u0435\u0441\u0442, \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u043e\u0440\u043e\u0433">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_TAGS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u043e\u0433\u0430">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_ReqIF.Name</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Настроить аварийный порог и последовательно подать значения ниже порога, равное порогу и
                выше порога. После срабатывания подтвердить аварию, изменять давление в диапазоне между
                порогом и порогом минус 0.2 bar, затем снизить его до порога минус 0.2 bar и снова
                превысить порог.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Набор граничных значений выявляет ошибки сравнения и подтверждает как правило формирования
                аварии, так и гистерезис, добавленный в SYS-002 версии v2.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_ACCEPTANCE_CRITERIA</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Авария не формируется для исходного значения ниже или равного порогу и формируется для
                каждого достоверного значения выше порога. После подтверждения значения выше порога минус
                0.2 bar не вызывают повторную аварию; после снижения до порога минус 0.2 bar или ниже
                следующее превышение порога формирует новую аварию.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0412 v2 \u0442\u0435\u0441\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0435\u043c \u0433\u0438\u0441\u0442\u0435\u0440\u0435\u0437\u0438\u0441\u0430 SYS-002 \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f UID \u0438 MID.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_b3d4a0ff607f48d8a64311f675b569f8_NOTES</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
