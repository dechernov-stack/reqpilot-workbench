            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u0439">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_829d2ef41f764d60b9d45486328ee869_ReqIF.Name</ATTRIBUTE-DEFINITION-STRING-REF>
