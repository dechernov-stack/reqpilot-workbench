            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0422\u0417 \u043f\u0438\u043b\u043e\u0442\u0430, \u0440\u0430\u0437\u0434\u0435\u043b 8">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0441\u0432\u044f\u0437\u044c, \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430, \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_TAGS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0442\u0435\u0440\u0438 \u0441\u0432\u044f\u0437\u0438 \u043d\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 3 \u0441\u0435\u043a\u0443\u043d\u0434">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ReqIF.Name</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Система должна обнаруживать потерю связи с источником телеметрии не позднее чем через 3
                секунды после последнего корректного сообщения.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Быстрое обнаружение отсутствия данных не позволяет оператору принимать устаревшее
                состояние насоса за актуальное.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ACCEPTANCE_CRITERIA</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>В 20 испытаниях с прекращением потока телеметрии признак потери связи устанавливается не
                позднее чем через 3,0 секунды после последнего принятого корректного сообщения.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
