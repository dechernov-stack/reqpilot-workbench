            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0430\u0432\u0442\u043e\u043c\u0430\u0442-\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439, \u0430\u0432\u0430\u0440\u0438\u044f, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435">
              <DEFINITION>
