            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435, \u043f\u043e\u0440\u043e\u0433">
