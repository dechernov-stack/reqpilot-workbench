                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_TAGS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0425\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 30 \u0441\u0443\u0442\u043e\u043a">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ReqIF.Name</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Система должна хранить журнал событий насосной станции не менее 30 календарных суток.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Тридцатисуточный интервал позволяет расследовать инциденты и анализировать поведение
                оборудования между плановыми циклами обслуживания.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_ACCEPTANCE_CRITERIA</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>Расчёт ёмкости и проверка тестовой временной шкалой подтверждают доступность всех событий
                за последние 30 суток при расчётной максимальной интенсивности 10 000 событий в сутки.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u0412 v2 \u0441\u0442\u0430\u0442\u0443\u0441 \u0438\u0437\u043c\u0435\u043d\u0451\u043d \u0441 Review \u043d\u0430 Approved \u043f\u043e \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044e Diff/Merge.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa_NOTES</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>REQUIREMENT_6e7c732402d844d0b49254c502829afa</SPEC-OBJECT-TYPE-REF>
          </TYPE>
