            <ATTRIBUTE-VALUE-STRING THE-VALUE="\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0430\u0432\u0430\u0440\u0438\u0438">
